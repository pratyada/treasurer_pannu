// TreasuryPulse India — Prisma Schema (MongoDB)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  name          String?
  role          String    @default("free") // free | paid | admin
  razorpaySubId String?
  createdAt     DateTime  @default(now())
  articles      Article[]
}

model Article {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  body        String
  excerpt     String
  category    String    // daily_news | insider
  source      String    @default("manual") // manual | rbi | sebi | rss | twitter
  tags        String    @default("[]") // JSON array stored as string
  authorNotes String?
  bookChapter String?
  isPremium   Boolean   @default(false)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String?   @db.ObjectId
  author      User?     @relation(fields: [authorId], references: [id])
}

model ScrapedDraft {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  summary     String
  sourceUrl   String?
  sourceName  String   // rbi | sebi | et | mint | twitter
  rawContent  String
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())
}

model JobPosting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  company     String
  title       String
  location    String
  salaryRange String?
  applyUrl    String
  description String
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Subscriber {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  name          String?
  plan          String    @default("free") // free | paid
  razorpaySubId String?
  status        String    @default("active") // active | cancelled | expired
  startedAt     DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}
