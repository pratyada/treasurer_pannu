# ============================================
# TreasuryPulse India — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Database — MongoDB Atlas (free tier at mongodb.com/atlas)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/treasurypulse?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/treasurypulse?retryWrites=true&w=majority"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-char-string-here"

# Admin credentials (Pranav's login)
ADMIN_EMAIL="pranav@treasurypulse.in"
ADMIN_PASSWORD="change-this-to-a-strong-password"

# Razorpay (get from razorpay.com/dashboard)
# Use test keys during development:
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# Subscription price in paise (₹50 = 5000 paise)
NEXT_PUBLIC_SUBSCRIPTION_PRICE_PAISE=5000
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"

# Scraper API key (must match scrapers/.env SCRAPER_API_KEY)
# Generate: openssl rand -hex 32
SCRAPER_API_KEY="generate-a-random-secret-key-here"

# App name (shown in Razorpay checkout)
NEXT_PUBLIC_APP_NAME="TreasuryPulse India"
